{
  "name": "shell-runner",
  "displayName": "VSCode Shell Runner",
  "description": "Run shell scripts directly from VS Code with a single click.",
  "version": "1.1.1",
  "author": "thomas-serment",
  "publisher": "thomas-serment",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomas-serment/VSCode-Shell-Runner"
  },
  "bugs": {
    "url": "https://github.com/thomas-serment/VSCode-Shell-Runner/issues"
  },
  "homepage": "https://github.com/thomas-serment/VSCode-Shell-Runner#readme",
  "icon": "images/icon.png",
  "keywords": [
    "shell",
    "bash",
    "runner",
    "script"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Shell Runner executes scripts, so it is disabled in Restricted Mode."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "shell-runner.runShell",
        "title": "Run Shell Script",
        "category": "Shell Runner",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "shell-runner.runShell",
          "when": "resourceExtname == .sh",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "shell-runner.runShell",
          "when": "resourceExtname == .sh"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
